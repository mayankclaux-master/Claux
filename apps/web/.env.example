# Application URL (Required in production)
# Production: https://clauxapp.automizemedialabs.com
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://clauxapp.automizemedialabs.com

# Legacy: NEXT_PUBLIC_SITE_URL (deprecated, use NEXT_PUBLIC_APP_URL instead)
# NEXT_PUBLIC_SITE_URL=

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Clerk Authentication (Required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Integration Encryption (Optional - for token storage)
INTEGRATION_ENCRYPTION_KEY=your_encryption_key_here

# Google OAuth (Optional - for Google integration feature)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here

# Optional APIs
OPENAI_API_KEY=sk_xxx
DATAFORSEO_API_KEY=your_dataforseo_key_here
SERP_API_KEY=your_serp_key_here

# n8n Integration (Optional - for webhook callback bridge only, NOT for orchestration)
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/claux
# N8N_API_KEY=your_n8n_api_key_here
# NOTE: Integration mesh orchestration removed in Phase 1A - n8n now used only for webhook callbacks
